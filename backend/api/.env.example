PORT=4000
DATABASE_URL=postgres://ritual:ritual@localhost:5432/ritual_ascension
JWT_SECRET=change-me-in-production
ADMIN_WALLETS=0x0000000000000000000000000000000000000000
ALLOWED_ORIGINS=http://localhost:3000
RITUAL_RPC_URL=https://example-ritual-rpc.invalid
RITUAL_CHAIN_ID=0
PASSPORT_NFT_ADDRESS=0x0000000000000000000000000000000000000000
PROGRESS_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
# Backend operator wallet — required for on-chain writes (awardXP, updateStage,
# linkDiscordAccount). Leave unset to keep progression fully off-chain.
BACKEND_OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000
BACKEND_OPERATOR_PRIVATE_KEY=
NEXT_PUBLIC_RITUAL_CHAIN_ID=0
NEXT_PUBLIC_PASSPORT_NFT_ADDRESS=0x0000000000000000000000000000000000000000
ORACLE_PROVIDER=gemini-openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional extra fallbacks — every key you set here is tried automatically
# if the ones above fail (quota, billing, downtime), no code changes needed.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
ORACLE_API_KEY=
ORACLE_ENDPOINT=
ORACLE_MODEL=
ORACLE_DOCS_ENDPOINT=
ORACLE_DOCS_API_KEY=
ORACLE_DISCORD_ENDPOINT=
ORACLE_DISCORD_API_KEY=
ORACLE_INDEXER_ENDPOINT=
ORACLE_INDEXER_API_KEY=
# Grok X Search — lets the Oracle pull live posts from specific X accounts
# (e.g. the Ritual Foundation's) into its answers. Comma-separated handles,
# no @ symbol.
GROK_API_KEY=
GROK_MODEL=grok-4.5
RITUAL_X_HANDLES=
RITUAL_INDEXER_LOOKBACK_BLOCKS=100000
RITUAL_TESTNET_INDEXER_ENDPOINT=
RITUAL_TESTNET_INDEXER_API_KEY=
DISCORD_ACTIVITY_ENDPOINT=
DISCORD_ACTIVITY_API_KEY=
