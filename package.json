{
  "name": "ritual-ascension",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend/*",
    "backend/*",
    "shared/*",
    "blockchain/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:frontend": "npm run dev -w frontend/web",
    "dev:backend": "npm run dev -w backend/api",
    "build": "npm run build -w shared/domain && npm run build -w backend/api && npm run build -w frontend/web",
    "build:contracts": "npm run build -w blockchain/contracts",
    "typecheck": "npm run typecheck -w shared/domain && npm run typecheck -w backend/api && npm run typecheck -w frontend/web",
    "lint": "npm run lint -w frontend/web"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.7",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.10.2",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.9.0",
    "typescript": "~6.0.3",
    "viem": "^2.52.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "type": "module"
}
